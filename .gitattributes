# Keep repository text files LF even when edited on Windows. Without this,
# writing data/JS files on Windows produced CRLF-only diffs across the whole
# state files (they are rewritten every run in CI on Linux).
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf

data/** text eol=lf
JS/**   text eol=lf

# Binary artifacts that must never be normalised.
*.pdf  binary
*.zip  binary
*.tgz  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary

# Extensionless / config files edited on Windows too.
.gitignore     text eol=lf
.gitattributes text eol=lf
uv.lock        text eol=lf
