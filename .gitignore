_artifact*/
_artifact*.zip
backup_*/
scripts/reports/

# Personal notes
说明/
机场司/
日志/


# Local backups
*.localbak

# Corrupted-state backups written by Storage.load(); never commit these.
data/*.corrupted.*
# Atomic-write leftovers (should not survive a clean run, but never commit).
data/*.json.tmp
JS/*.tmp
