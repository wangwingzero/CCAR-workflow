*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/

# Node / Cloudflare
node_modules/
.wrangler/

# uv
# uv.lock is committed for reproducible CI builds

# Downloads (archived to Cloudflare R2 + CI artifacts; not stored in git)
downloads/

